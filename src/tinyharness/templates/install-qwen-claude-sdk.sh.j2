#!/bin/bash
set -euo pipefail

if command -v apk &> /dev/null; then
    apk add --no-cache bash curl git procps python3
elif command -v apt-get &> /dev/null; then
    apt-get update
    apt-get install -y bash curl git procps python3 python3-venv
fi

curl -LsSf https://astral.sh/uv/{{ uv_version }}/install.sh | sh

export PATH="$HOME/.local/bin:$PATH"

uv python install {{ python_version }}
uv venv /installed-agent/.venv --python {{ python_version }}
uv pip install --python /installed-agent/.venv/bin/python \
  "claude-agent-sdk=={{ sdk_version }}" \
  "dspy=={{ dspy_version }}" \
  "gepa[dspy]=={{ gepa_version }}"{{ extra_python_packages }}

cat > /installed-agent/dspy_prompt.py <<'PY'
{{ dspy_prompt_script }}
PY

cat > /installed-agent/sdk_runner.py <<'PY'
{{ runner_script }}
PY

chmod +x /installed-agent/sdk_runner.py
/installed-agent/.venv/bin/python -m compileall /installed-agent/dspy_prompt.py /installed-agent/sdk_runner.py >/dev/null
