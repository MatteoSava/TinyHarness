# Optional if `modal` CLI is already authenticated via profile/config.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional if the Modal workspace already has a secret named `huggingface-secret`.
HF_TOKEN=
HUGGINGFACE_TOKEN=
HUGGING_FACE_HUB_TOKEN=
TINYHARNESS_PROXY_TOKEN=
# Optional. Local MLflow works without these.
# Required only for the remote MLflow server on Modal.
# Example: postgresql+psycopg://user:pass@host:5432/mlflow
TINYHARNESS_MLFLOW_BACKEND_STORE_URI=
TINYHARNESS_MLFLOW_ADMIN_PASSWORD=
TINYHARNESS_MLFLOW_FLASK_SECRET_KEY=
